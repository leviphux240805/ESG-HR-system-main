# Sao chép thành .env rồi sửa theo máy mình. KHÔNG commit .env.
# docker compose đọc file này; backend cũng tự nạp ../.env khi chạy trong thư mục backend/.
# Bỏ trống hoặc không có .env thì dùng các giá trị mặc định dev bên dưới.

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=preschool
DB_USERNAME=preschool
DB_PASSWORD=preschool

# --- S3 / MinIO ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=preschool
S3_SECRET_KEY=preschool-secret

# --- Backend ---
SERVER_PORT=8081

# Khóa ký JWT (>= 32 ký tự). Dev có sẵn khóa mặc định; môi trường thật BẮT BUỘC đặt.
# Bỏ comment chỉ khi có giá trị: dòng "JWT_SECRET=" để trống sẽ ghi đè mặc định bằng chuỗi rỗng.
# JWT_SECRET=
# Cờ Secure cho cookie refresh; dev (http://localhost) mặc định false, môi trường thật để true.
# COOKIE_SECURE=true
