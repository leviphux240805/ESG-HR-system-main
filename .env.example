# Sao chép thành .env rồi sửa theo máy mình. KHÔNG commit .env.
# docker compose đọc file này; backend cũng tự nạp ../.env khi chạy trong thư mục backend/.
# Bỏ trống hoặc không có .env thì dùng các giá trị mặc định dev bên dưới.

# --- PostgreSQL ---
# Dùng một trong hai cách:
# 1) Full JDBC URL (Render/Neon phổ biến):
# DB_URL=jdbc:postgresql://localhost:5432/preschool?sslmode=prefer
# 2) Hoặc các biến tách riêng:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=preschool
DB_USERNAME=preschool
DB_PASSWORD=preschool
# Neon/Postgres có SSL bắt buộc: DB_SSLMODE=require (mặc định prefer)
# DB_SSLMODE=require
# Một số provider cũng dùng tên DATABASE_URL / DATABASE_USERNAME / DATABASE_PASSWORD.
# DATABASE_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
# DATABASE_USERNAME=
# DATABASE_PASSWORD=

# --- S3 / MinIO ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=preschool
S3_SECRET_KEY=preschool-secret
# Địa chỉ S3 mà cả backend và trình duyệt truy cập được (link upload/tải trỏ vào đây).
# Mặc định http://localhost:${S3_PORT}. Bỏ comment khi dùng S3 thật hoặc máy khác.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=preschool
# S3_REGION=us-east-1
# Cloudflare R2: S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, S3_REGION=auto, khóa lấy từ R2 API token

# --- Email (dev dùng Mailpit: SMTP localhost:1025, xem thư tại http://localhost:8025) ---
MAIL_PORT=1025
MAILPIT_UI_PORT=8025
# Môi trường thật: bỏ comment và điền SMTP thật
# MAIL_HOST=smtp.example.com
# Brevo: MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=2525 (Render free chặn 25/465/587)
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=Preschool Management <no-reply@ten-mien.vn>
# Địa chỉ web app, dùng dựng link trong email (mặc định http://localhost:8080)
# FRONTEND_URL=https://app.ten-mien.vn

# --- Backend ---
SERVER_PORT=8081

# Khóa ký JWT (>= 32 ký tự). Dev có sẵn khóa mặc định; môi trường thật BẮT BUỘC đặt.
# Bỏ comment chỉ khi có giá trị: dòng "JWT_SECRET=" để trống sẽ ghi đè mặc định bằng chuỗi rỗng.
# JWT_SECRET=
# Cờ Secure cho cookie refresh; dev (http://localhost) mặc định false, môi trường thật để true.
# COOKIE_SECURE=true
